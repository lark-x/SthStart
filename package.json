{
  "name": "sthstart",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "env:init": "node scripts/init-env.mjs",
    "setup:vector": "node scripts/setup-vector.mjs",
    "doctor": "node scripts/linshe-doctor.mjs",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:check": "node --import tsx scripts/database.ts check",
    "db:integrity": "node --import tsx scripts/database.ts integrity",
    "db:reset": "node --import tsx scripts/database.ts reset",
    "db:backup": "node --import tsx scripts/database.ts backup",
    "db:restore": "node --import tsx scripts/database.ts restore",
    "dev": "concurrently --kill-others-on-fail --names portal,service --prefix-colors cyan,green \"npm run dev:portal\" \"npm run dev:service\"",
    "dev:portal": "vinext dev",
    "dev:service": "npm run dev --workspace @sthstart/service",
    "dev:linshe": "node scripts/linshe-runner.mjs",
    "dev:all": "concurrently --kill-others-on-fail --names portal,service,linshe --prefix-colors cyan,green,magenta \"npm run dev:portal\" \"npm run dev:service\" \"npm run dev:linshe\"",
    "linshe:use-fork": "node scripts/use-linshe-fork.mjs",
    "build": "npm run build:portal && npm run build:service",
    "build:portal": "vinext build",
    "build:service": "npm run build --workspace @sthstart/service",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test:portal && npm run test --workspaces --if-present",
    "test:e2e": "npm run build && playwright test",
    "test:portal": "node --import tsx --test app/lib/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run lint",
    "start": "npm run start:local",
    "stop": "node scripts/stop-local.mjs",
    "start:portal": "vinext start --port 4173 --hostname 127.0.0.1",
    "start:portal:lan": "vinext start --port 4173 --hostname 0.0.0.0",
    "start:service": "npm run start --workspace @sthstart/service",
    "start:local": "concurrently --kill-others-on-fail --names portal,service --prefix-colors cyan,green \"npm run start:portal\" \"npm run start:service\"",
    "start:lan": "node scripts/start-lan.mjs",
    "start:lan:processes": "concurrently --kill-others-on-fail --names portal,service --prefix-colors cyan,green \"npm run start:portal:lan\" \"npm run start:service\"",
    "start:local:all": "npm run start:local",
    "start:local:legacy": "concurrently --kill-others-on-fail --names portal,service,linshe --prefix-colors cyan,green,magenta \"npm run start:portal\" \"npm run start:service\" \"npm run dev:linshe\"",
    "deploy:local": "npm run build && npm run start:local",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern upstream"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sinclair/typebox": "^0.34.52",
    "@sthstart/contracts": "0.1.0",
    "@tanstack/react-query": "^5.102.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260823.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "concurrently": "^9.2.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
