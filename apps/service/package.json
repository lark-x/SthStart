{
  "name": "@sthstart/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "build": "npm run build --workspace @sthstart/activity-playback && tsc -p tsconfig.json && npm run build:comic-reader",
    "build:comic-reader": "vite build --config vite.comic-reader.config.mjs",
    "start": "node --import tsx/esm dist/start.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx/esm --test --test-concurrency=1 dist/*.test.js dist/*/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-rc.2",
    "@fastify/cors": "^11.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.41",
    "@sthstart/activity-playback": "0.1.0",
    "@sthstart/contracts": "0.1.0",
    "cross-keychain": "^1.1.0",
    "fastify": "^5.6.2",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/opentype.js": "^1.3.8",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
