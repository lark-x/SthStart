PORTAL_PORT=4173
SERVICE_HOST=127.0.0.1
SERVICE_PORT=4100
PORTAL_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
LINSHE_APP_URL=http://127.0.0.1:5173
LINSHE_HEALTH_URL=http://127.0.0.1:3099/api/health
# 远程访问时与 LINSHE_APP_URL 同步为 https://linshe.<你的域名>
LINSHE_VERSION=
LINSHE_SOURCE_REVISION=
PROBE_TIMEOUT_MS=2000
NEXT_PUBLIC_STHSTART_SERVICE_URL=http://127.0.0.1:4100
NEXT_PUBLIC_LINSHE_APP_URL=http://127.0.0.1:5173
# 远程访问时与 LINSHE_APP_URL 同步为同一个 https 地址，并重新构建 Portal。

# 公共服务管理令牌只在服务端/BFF 使用，不会发送给浏览器。
STHSTART_ADMIN_TOKEN=
# 至少 32 字符；用于 8 小时 HttpOnly 管理会话签名。
STHSTART_SESSION_SECRET=
# 远程 Portal 的精确 Origin，多个以逗号分隔。本机 Origin 会自动允许。
STHSTART_PUBLIC_ORIGINS=
# 仅由 npm run start:lan 临时启用；不要在公共 Wi-Fi 手动开启。
STHSTART_LAN_ACCESS=false
# 远程管理复用 Cloudflare Access；例如 team.cloudflareaccess.com。
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
STHSTART_IMAGE_SIGNING_SECRET=
STHSTART_DATABASE_PATH=./data/sthstart.db
STHSTART_NARRATIVE_DATABASE_PATH=./data/narrative.db
STHSTART_ARTIFACT_DIR=./data/artifacts
STHSTART_LOG_DIR=./data/logs
STHSTART_LINSHE_ROOT=./upstream/linshe
STHSTART_VECTOR_URL=http://127.0.0.1:8765
STHSTART_AKASHA_MCP_URL=https://agent.zlb.ink/api/mcp/
STHSTART_MCP_TIMEOUT_MS=45000

# 独立启动邻舍并启用公共 LLM 时，填入一个稳定的高熵应用令牌；
# 通过 SthStart 控制中心托管邻舍时会自动注入，无需手工填写。
STHSTART_SERVICE_URL=http://127.0.0.1:4100
STHSTART_PORTAL_URL=http://127.0.0.1:4173
STHSTART_APP_TOKEN=
# 旧版 STHSTART_LLM_PROFILE 仅用于一次性迁移；新版本在公共服务页面按应用选择模型。
STHSTART_VECTOR_PROFILE=
STHSTART_IMAGE_PROFILE=
STHSTART_PUBLIC_LLM=false
STHSTART_PUBLIC_VECTOR=false
STHSTART_PUBLIC_IMAGE=false
