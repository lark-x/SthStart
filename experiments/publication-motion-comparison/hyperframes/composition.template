<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=1080,height=1920">
<title>雪山回声 · Hyperframes</title><script src="vendor/gsap/gsap.min.js"></script>
<style>
@font-face{font-family:NotoComic;src:url('assets/NotoSansSC-VF.ttf') format('truetype');font-weight:100 900;font-display:block}
*{box-sizing:border-box;margin:0}html,body,#root{width:1080px;height:1920px;overflow:hidden;background:#101d28;color:#f5efdf;font-family:NotoComic,sans-serif}#root{position:relative;background-image:radial-gradient(#f5efdf18 1.5px,transparent 1.5px);background-size:14px 14px}.scene{position:absolute;inset:0;opacity:0}.mast{position:absolute;top:95px;left:80px;font-size:30px;letter-spacing:5px;color:var(--accent)}.headline{position:absolute;left:80px;top:155px;width:920px;font-size:60px;font-weight:800;line-height:1.3}.hero{position:absolute;left:70px;width:940px;overflow:hidden;border:8px solid #f5efdf;transform:rotate(var(--angle));box-shadow:0 28px 70px #0008}.shadow{position:absolute;left:60px;width:940px;background:var(--accent);opacity:.25;transform:rotate(-1.8deg)}.art{position:absolute;inset:-24px}.art img{width:100%;height:100%;object-fit:cover;object-position:center}.chapter{position:absolute;left:24px;top:24px;background:#101d28;padding:10px 22px;font-size:28px;letter-spacing:4px}.glow{position:absolute;inset:0;background:#81dbef;mix-blend-mode:screen;opacity:.12}.caption{position:absolute;left:80px;top:1485px;width:920px;opacity:0}.speaker{font-size:32px;font-weight:700;letter-spacing:5px;color:var(--accent);margin-bottom:16px}.bubble{position:relative;background:#f5efdf;color:#101d28;padding:32px 40px;font-size:48px;line-height:1.42;font-weight:600;box-shadow:10px 12px 0 #0007;border-left:10px solid var(--accent)}.tail{position:absolute;top:-17px;left:48px;width:32px;height:32px;background:#f5efdf;transform:rotate(45deg)}.snow{position:absolute;inset:0;pointer-events:none;overflow:hidden}.flake{position:absolute;background:#f5efdf;border-radius:50%}.footer{position:absolute;bottom:92px;left:80px;right:80px;display:flex;justify-content:space-between;font-size:23px;letter-spacing:4px;color:#b9c2c7}.bookend{position:absolute;inset:0;background:#101d28}.opening img{position:absolute;width:100%;height:100%;object-fit:cover;opacity:.45}.opening::after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#101d28 2%,#101d2800 90%);pointer-events:none}.bookend .content{position:absolute;inset:0;z-index:2}.intro-kicker{position:absolute;left:80px;top:585px;font-size:31px;letter-spacing:10px;color:#e2bc76}.intro-title{position:absolute;left:76px;top:695px;font-size:166px;font-weight:900;line-height:1.13;letter-spacing:12px}.intro-actors{position:absolute;left:80px;top:1190px;font-size:40px;letter-spacing:3px}.intro-note{position:absolute;left:80px;top:1270px;font-size:32px;color:#c7cdd1}.intro-legal{position:absolute;left:80px;bottom:165px;font-size:25px;color:#d4d9da}.closing{opacity:0}.closing .kicker{position:absolute;left:80px;top:640px;font-size:32px;color:#e2bc76;letter-spacing:8px}.closing h1{position:absolute;left:80px;top:750px;font-size:85px;line-height:1.5;font-weight:800}.closing .note{position:absolute;left:80px;top:1170px;font-size:36px;color:#aebec5}.closing .legal{position:absolute;left:80px;bottom:170px;font-size:26px;color:#aebec5}
</style></head><body>
<div id="root" data-composition-id="SnowEcho" data-start="0" data-duration="67.93333333333334" data-width="1080" data-height="1920" data-fps="30">
<audio id="soundtrack" class="clip" src="assets/soundtrack.wav" data-start="0" data-duration="67.93333333333334" data-track-index="0"></audio>
<div id="intro" class="bookend opening clip" data-start="0" data-duration="2.4" data-track-index="7"><img src="assets/shot-1.png" alt="雪山营地"><div class="content"><div class="intro-kicker">DRAGONSPINE / 雪夜观察</div><h1 class="intro-title">雪山<br>回声<span style="color:#e2bc76">。</span></h1><div class="intro-actors">阿贝多 × 砂糖</div><div class="intro-note">一次不急着寻找答案的实验</div><div class="intro-legal">原神同人短篇 / 非官方剧情</div></div></div>
<!--SCENES-->
<div id="outro" class="bookend closing clip" data-start="65.7" data-duration="2.23333333333334" data-track-index="7"><div class="kicker">观察记录 / 未完</div><h1>把答案，<br>留给下一次实验。</h1><div class="note">雪山似乎，也在回答我们。</div><div class="legal">雪山回声 / 原神同人 · 非官方剧情</div></div>
<div class="snow" id="snow"></div><div class="footer"><span>雪山回声</span><span>原神同人 · 非官方剧情</span></div>
</div>
<script>
const manifest=/*MANIFEST*/;
const tl=gsap.timeline({paused:true});
tl.fromTo('.intro-title',{opacity:0,y:50},{opacity:1,y:0,duration:.55,ease:'power3.out'},.1);
tl.fromTo('#intro img',{scale:1},{scale:1.06,duration:2.4,ease:'none'},0);
tl.set('#intro',{opacity:0},2.4);
for(const s of manifest.shots){
 const id='#scene-'+s.index,start=s.startMs/1000,end=s.endMs/1000;
 tl.set(id,{opacity:1},start).set(id,{opacity:0},end);
 tl.fromTo(id+' .hero',{opacity:0,x:100},{opacity:1,x:0,duration:.4,ease:'power3.out'},start);
 tl.to(id+' .hero',{opacity:0,duration:.23,ease:'none'},end-.23);
 tl.fromTo(id+' .headline',{opacity:0,x:25},{opacity:1,x:0,duration:.4,ease:'power3.out'},start);
 tl.fromTo(id+' .art',{scale:1.02,x:s.index%2?-16:16},{scale:1.10,x:s.index%2?16:-16,duration:s.durationMs/1000,ease:'none'},start);
 if(s.index===1)document.querySelector(id+' .art img').style.objectPosition='42% 48%';
 for(const [i,c] of s.captions.entries()){
  const target='#caption-'+s.index+'-'+i;
  tl.fromTo(target,{opacity:0,y:24},{opacity:1,y:0,duration:.2,ease:'power2.out'},c.startMs/1000);
  tl.set(target,{opacity:0},c.endMs/1000);
 }
}
tl.set('#outro',{opacity:1},65.7).fromTo('#outro h1',{opacity:0},{opacity:1,duration:.4},65.7);
// Independent deterministic procedural tween makes out-of-order seeks correct.
const flakes=[];for(let i=0;i<30;i++){const e=document.createElement('div');e.className='flake';e.style.left=(i*173+19)%1080+'px';e.style.width=e.style.height=3+i%5+'px';e.style.opacity=.10+i%3*.07;document.querySelector('#snow').appendChild(e);flakes.push(e)}
const clock={t:0};tl.to(clock,{t:manifest.durationMs/1000,duration:manifest.durationMs/1000,ease:'none',onUpdate(){const f=clock.t*30;flakes.forEach((e,i)=>{e.style.top=((i*97+f*(1.5+i%4))%2130)-100+'px';e.style.transform='translateX('+Math.sin(f/70+i)*16+'px)'})}},0);
tl.to({}, {duration:manifest.durationMs/1000},0);
window.__timelines=window.__timelines||{};window.__timelines.SnowEcho=tl;tl.seek(0);
</script></body></html>
