# ==============================================================================
# SthStart Docker 环境变量模板 (.env)
# ==============================================================================

# 对外暴露的 Portal 端口（宿主机访问端口）
PORTAL_PORT=4173

# 安全凭据（生产环境务必填写，且至少 32 字符）
# 可用 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" 分别生成
STHSTART_ADMIN_TOKEN=
STHSTART_IMAGE_SIGNING_SECRET=
STHSTART_SESSION_SECRET=

# 局域网访问控制：true 允许私有局域网 IP（192.168.x.x, 10.x.x.x, 172.16-31.x.x）直连
STHSTART_LAN_ACCESS=true

# 远程域名访问（通过公网反向代理或穿透时填写，多个用逗号隔开）
STHSTART_PUBLIC_ORIGINS=

# Cloudflare Access 保护（可选）
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Akasha MCP 服务地址与鉴权 Key（Bearer Token）
STHSTART_AKASHA_MCP_URL=https://agent.zlb.ink/api/mcp/
STHSTART_AKASHA_MCP_KEY=
STHSTART_MCP_TIMEOUT_MS=45000

# 宿主机 ComfyUI / Windows Worker / 邻舍桥接
# 容器内通过 host.docker.internal 访问宿主机服务
# STHSTART_VECTOR_URL=http://host.docker.internal:8765
# LINSHE_HEALTH_URL=http://host.docker.internal:3099/api/health
